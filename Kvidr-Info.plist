<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys Xcode's generated Info.plist has no build setting for; merged into it. -->
	<!-- An iPhone as the camera in a call, through Continuity Camera. -->
	<key>NSCameraUseContinuityCameraDeviceType</key>
	<true/>
	<!-- iOS: a call keeps its audio when you leave the app or lock the phone. macOS ignores it. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
