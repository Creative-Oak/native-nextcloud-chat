<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys Xcode's generated Info.plist has no build setting for; merged into it. -->
	<!-- An iPhone as the camera in a call, through Continuity Camera. -->
	<key>NSCameraUseContinuityCameraDeviceType</key>
	<true/>
	<!-- kvidr:// links, for Raycast and scripts — they open and fill in, never send. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.kvidr.mac</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kvidr</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
