        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på forbindelse"
          }
        }
      }
    },
    "Waiting for the lobby to open" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venter på, at lobbyen åbner"
          }
        }
      }
    },
    "Waiting…" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
