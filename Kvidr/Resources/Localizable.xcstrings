            "value" : "Dig, lyd slået fra"
          }
        }
      }
    },
    "Your Nextcloud password is never sent to this app. You’ll approve access in your browser, and can revoke it at any time in Nextcloud’s security settings." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Nextcloud-adgangskode sendes aldrig til denne app. Du godkender adgangen i din browser og kan til enhver tid tilbagekalde den i Nextclouds sikkerhedsindstillinger."
          }
        }
      }
    },
    "Your audio couldn’t reach the call." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din lyd kunne ikke nå frem til opkaldet."
