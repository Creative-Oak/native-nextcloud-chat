    "Written on this Mac by Apple Intelligence. Nothing is marked as read." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrevet på denne Mac af Apple Intelligence. Intet markeres som læst."
