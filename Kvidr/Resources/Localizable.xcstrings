    "kvidr" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr"
          }
        }
      }
    },
    "kvidr couldn’t find that conversation." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr kunne ikke finde samtalen."
          }
        }
      }
    },
    "kvidr couldn’t revoke its own access on the server — remove this device under Security in your Nextcloud settings." : {
      "comment" : "Sign-out warning; “Security” is the name of a page in Nextcloud’s settings",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr kunne ikke tilbagekalde sin egen adgang på serveren — fjern denne enhed under Sikkerhed i dine Nextcloud-indstillinger."
          }
        }
      }
    },
    "kvidr couldn’t tell which language this is in." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr kunne ikke se, hvilket sprog det er."
          }
        }
      }
    },
    "kvidr couldn’t tell which language you wrote in." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr kunne ikke se, hvilket sprog du skrev på."
          }
        }
      }
    },
    "kvidr couldn’t use your Keychain, so your sign-in couldn’t be saved." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr kunne ikke bruge din nøglering, så dit login kunne ikke gemmes."
          }
        }
      }
    },
    "kvidr follows each conversation’s notification setting from Nextcloud — right-click a conversation in the sidebar to change it. Notifications arrive while kvidr is running; closing the window keeps it running, quitting does not." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr følger hver samtales notifikationsindstilling fra Nextcloud — højreklik på en samtale i indholdsoversigten for at ændre den. Notifikationer kommer, mens kvidr kører; lukker du vinduet, kører kvidr videre, men ikke hvis du afslutter."
          }
        }
      }
    },
    "kvidr had no saved app password for this account, so there was nothing it could revoke — if this Mac is still listed under Security in your Nextcloud settings, remove it there." : {
      "comment" : "Sign-out warning; “Security” is the name of a page in Nextcloud’s settings",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr havde ingen gemt app-adgangskode til denne konto, så der var intet at tilbagekalde — hvis denne Mac stadig står under Sikkerhed i dine Nextcloud-indstillinger, så fjern den der."
          }
        }
      }
    },
    "kvidr isn’t allowed to add to Calendar. Allow it in System Settings → Privacy & Security → Calendar." : {
      "comment" : "Use the names of the Calendar app and of the settings as macOS shows them",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr har ikke tilladelse til at føje til Kalender. Giv tilladelse i Systemindstillinger → Anonymitet og sikkerhed → Kalendere."
          }
        }
      }
    },
    "kvidr isn’t allowed to add to Reminders. Allow it in System Settings → Privacy & Security → Reminders." : {
      "comment" : "Use the names of the Reminders app and of the settings as macOS shows them",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr har ikke tilladelse til at føje til Påmindelser. Giv tilladelse i Systemindstillinger → Anonymitet og sikkerhed → Påmindelser."
          }
        }
      }
    },
    "kvidr isn’t allowed to use the camera. Turn it on in System Settings → Privacy & Security → Camera." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr har ikke tilladelse til at bruge kameraet. Slå det til i Systemindstillinger → Anonymitet og sikkerhed → Kamera."
          }
        }
      }
    },
    "kvidr isn’t allowed to use the microphone. You can allow it in System Settings ▸ Privacy & Security ▸ Microphone." : {
      "comment" : "Recording a voice message without microphone permission; use the System Settings names of this language",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr har ikke adgang til mikrofonen. Du kan give adgang i Systemindstillinger ▸ Anonymitet og sikkerhed ▸ Mikrofon."
          }
        }
      }
    },
    "kvidr isn’t signed in to Nextcloud." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr er ikke logget ind på Nextcloud."
          }
        }
      }
    },
    "kvidr’s access in Nextcloud is revoked, and the conversations and drafts kept on this Mac are deleted. Your messages stay on the server." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidrs adgang til Nextcloud tilbagekaldes, og de samtaler og kladder, der er gemt på denne Mac, slettes. Dine beskeder bliver på serveren."
          }
        }
      }
    },
    "kvidr’s access to %@ has expired or was revoked." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidrs adgang til %@ er udløbet eller blevet tilbagekaldt."
          }
        }
      }
    },
