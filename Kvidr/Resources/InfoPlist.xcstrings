      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr tilføjer en opgave fra en besked til Påmindelser, når du beder om det."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "kvidr adds a to-do from a message to Reminders when you ask it to."
          }
