    "NSCalendarsWriteOnlyAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Write Only Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr tilføjer et møde fra en besked til din kalender, når du beder om det."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "kvidr adds a meeting from a message to your calendar when you ask it to."
          }
        }
      }
    },
