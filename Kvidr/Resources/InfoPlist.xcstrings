      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr viser dit kamera til de andre i et videoopkald, når du slår det til."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "kvidr shows your camera to the people in a video call, when you turn it on."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kvidr bruger mikrofonen til opkald og til at optage en talebesked, når du trykker på optageknappen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "kvidr uses the microphone for calls, and to record a voice message when you press the record button."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "comment" : "Privacy - Reminders Full Access Usage Description",
