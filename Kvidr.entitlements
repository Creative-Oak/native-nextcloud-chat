<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A messaging client has no business reading the user's disk. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outgoing HTTPS to the user's Nextcloud. No server socket, ever. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Phase 7, for attaching files the user picks. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- The data-protection keychain, where the app password and the cache keys live.
	     A Mac app without an access group can't use it at all: every write fails with
	     errSecMissingEntitlement, and sign-in with it. This one is the app's own. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.kvidr.mac</string>
	</array>
</dict>
</plist>
